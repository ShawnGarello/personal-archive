---
import ReadingDocument from '../components/ReadingDocument.astro';
import { fictionalDocuments } from '../content/fictional-documents';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Fictional documents for the Personal Archive reading study." />
    <title>Fictional reading study · Personal Archive</title>
    <script is:inline>
      // Choose the entrance before first paint. Without JavaScript, or if the
      // experience module fails to run, the document stays in its plain layout.
      (() => {
        const root = document.documentElement;
        const scene = !matchMedia('(prefers-reduced-motion: reduce)').matches && 'WebGL2RenderingContext' in window;
        const readDirectly = () => {
          root.dataset.phase = 'reading';
          root.dataset.surface = 'flat';
        };
        root.dataset.phase = scene ? 'loading' : 'reading';
        root.dataset.surface = scene ? 'scene' : 'flat';
        // One document at a time; the module adds the navigation controls.
        root.dataset.paged = '';
        // Direct access must not wait for the module, which may still be
        // downloading (and delaying DOMContentLoaded). The module adopts this choice.
        document.addEventListener('click', (event) => {
          if (root.dataset.booted || root.dataset.phase === 'reading') return;
          const target = event.target instanceof Element ? event.target.closest('[data-action="read"], .skip-link') : null;
          if (!target) return;
          event.preventDefault();
          readDirectly();
          document.getElementById('reading')?.focus();
        }, true);
        document.addEventListener('DOMContentLoaded', () => {
          if (root.dataset.booted) return;
          readDirectly();
          delete root.dataset.paged; // Without the module, show every document in order.
        });
      })();
    </script>
    <script>
      import '../scripts/experience/main';
    </script>
  </head>
  <body>
    <a class="skip-link" href="#reading">Skip to document</a>
    <header class="site-header">
      <p>Personal Archive</p>
      <p>Reading study</p>
    </header>
    <div class="scene-layer" aria-hidden="true"><canvas data-scene-canvas></canvas></div>
    <div class="dock">
      <p class="experience-status" data-status role="status"></p>
      <section class="entrance" data-entrance aria-label="Archive entrance">
        <button type="button" class="entrance-open" data-action="open" aria-disabled="true">Open the archive</button>
        <button type="button" class="entrance-read" data-action="read">Go straight to the document</button>
      </section>
    </div>
    <div class="paper" data-paper>
      <main id="reading" class="reading-frame" tabindex="-1">
        {fictionalDocuments.map((document, index) => <ReadingDocument document={document} active={index === 0} />)}
      </main>
    </div>
    <nav class="document-nav" data-document-nav aria-label="Documents">
      <button type="button" data-action="previous">Previous<span class="visually-hidden"> document</span></button>
      <p class="document-position" data-document-position aria-live="polite" aria-atomic="true">
        <span class="position-word">Document </span>1 of {fictionalDocuments.length}<span class="visually-hidden">: {fictionalDocuments[0].title}</span>
      </p>
      <button type="button" data-action="next">Next<span class="visually-hidden"> document</span></button>
    </nav>
    <footer class="site-footer"><p>Fictional content. Provisional page layout.</p></footer>
  </body>
</html>
