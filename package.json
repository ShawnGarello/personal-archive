{
  "name": "personal-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "typecheck": "astro check --root app --config ../astro.config.mjs",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run typecheck && npm run lint",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "astro": "7.3.5",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
